# ---- Core ----
DATABASE_URL="postgresql://inboxzero:inboxzero@localhost:5432/inboxzero?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Trust the Host header when building Auth.js callback URLs. Leave false unless a trusted reverse proxy
# sets Host and AUTH_URL is not configured.
AUTH_TRUST_HOST="false"

# ---- Sign-in Google OAuth (openid/email/profile only) ----
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Gmail connection OAuth (gmail.readonly) ----
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# 32-byte key, base64. Encrypts OAuth tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Cron/worker auth for POST /api/sync
SYNC_SECRET="generate-with-openssl-rand-hex-32"

# ---- AI provider ----
# ollama | gemini | none
AI_PROVIDER="none"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
# Gemini is only used for email content when GEMINI_TIER=paid AND the user has
# explicitly enabled cloud processing in Settings. Free tier never receives email content.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIER="free"
# Daily AI call budget per user (cost control)
AI_DAILY_CALL_LIMIT="200"
